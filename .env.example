# Server port
PORT=3001

# TURN server credentials (required for production)
# Leave empty to disable TURN (WebRTC may fail behind strict NAT)
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=

# Client-side: URL of the signaling server
# In production: wss://yourdomain.com
VITE_SERVER_URL=ws://localhost:3001
